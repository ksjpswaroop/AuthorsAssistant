<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The App Store requires the sandbox. AegisDraft only ever touches the
       project folder the author picks, so a user-selected read/write scope is
       the whole of what it needs. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- Reopening a project on launch without asking again. -->
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>

  <!-- Phase 3 shipped, so this is now needed: the sandbox blocks outgoing
       connections without it, loopback included, and Ollama runs on
       127.0.0.1:11434. Client only — the app listens on nothing. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
